# Playwright E2E image. Python 3.12 matches pyproject.toml requires-python >=3.11.
FROM python:3.12-slim-bookworm

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    DJANGO_SETTINGS_MODULE=seim.settings.test \
    DOCKER_ENV=true \
    PLAYWRIGHT_BROWSERS_PATH=/ms-playwright

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        build-essential \
        libpq-dev \
        gcc \
        gettext \
        libmagic1 \
        curl \
        ca-certificates && \
    rm -rf /var/lib/apt/lists/*

# Pins live in pyproject.toml (pip install ".[test]")
COPY pyproject.toml README.md LICENSE ./
COPY seim/ seim/

RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir ".[test]"

RUN playwright install-deps chromium
RUN playwright install chromium

COPY . .

RUN mkdir -p tests/e2e_playwright/screenshots \
    tests/e2e_playwright/videos \
    tests/e2e_playwright/reports \
    tests/e2e_playwright/visual/snapshots \
    tests/e2e_playwright/visual/diffs \
    tests/e2e_playwright/visual/reports

CMD ["pytest", "tests/e2e_playwright/", "-v"]
