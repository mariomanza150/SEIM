# syntax=docker/dockerfile:1
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE 1
ENV PYTHONUNBUFFERED 1

WORKDIR /app

# Install system dependencies
RUN apt-get update && \
    apt-get install -y build-essential libpq-dev gcc gettext && \
    rm -rf /var/lib/apt/lists/*

RUN apt-get update && apt-get install -y libmagic1 && rm -rf /var/lib/apt/lists/*

# Note: Selenium tests run from HOST OS, not Docker containers
# Chrome and ChromeDriver are not installed in Docker

# Pins live in pyproject.toml (pip install ".[test]")
COPY pyproject.toml README.md LICENSE ./
COPY seim/ seim/
RUN pip install --upgrade pip && \
    pip install --no-cache-dir ".[test]"

# Copy project files
COPY . .

# Build-time Django commands must not require development secrets (AWS/SMTP/.env).
ENV DJANGO_SETTINGS_MODULE=seim.settings.test \
    SECRET_KEY=build-time-placeholder-not-for-runtime \
    DEBUG=false \
    TESTING=true

# Match CI: compile locale catalogs (requires gettext)
RUN python manage.py compilemessages -l de -l es -l fr

# Make the wait-for-db script executable
RUN chmod +x /app/scripts/wait-for-db.sh

# Expose port for Django
EXPOSE 8000

# Entrypoint for Django (can be overridden in docker-compose)
CMD ["/app/scripts/wait-for-db.sh"] 