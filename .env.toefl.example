# TOEFL Practice sidecar (use with docker-compose.toefl.yml or prod/local-prod)
#
# Dev (alongside default compose):
#   docker compose -f docker-compose.yml -f docker-compose.override.yml -f docker-compose.toefl.yml --env-file .env up -d --build
# Requires sibling checkout at TOEFL_CONTEXT (default ../toefl-practice).
# Matching secrets must be set in SEIM .env (see env.example TOEFL_* block).
#
TOEFL_CONTEXT=../toefl-practice
TOEFL_API_BASE_URL=http://toefl:5000
TOEFL_API_KEY=toefl-api-key-change-me
TOEFL_SIGNING_SECRET=toefl-signing-secret-change-me
TOEFL_SECRET_KEY=toefl-secret-key-change-me
TOEFL_PUBLIC_BASE_URL=http://localhost:5020
TOEFL_APPLICATION_ROOT=
TOEFL_CALLBACK_URL=http://web:8000/api/toefl/webhook/
TOEFL_RETURN_URL=http://localhost:8001/seim/toefl-practice
TOEFL_DEFAULT_EXAM_CODE=director_extracted
TOEFL_ADMIN_PASSWORD=admin
