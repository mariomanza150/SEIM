{
  "name": "seim",
  "private": true,
  "description": "Root scripts proxy to the Vue SPA in frontend-vue/. App UI is served at /seim/.",
  "scripts": {
    "build": "npm --prefix frontend-vue run build",
    "dev": "npm --prefix frontend-vue run dev",
    "test": "npm --prefix frontend-vue run test:run",
    "test:watch": "npm --prefix frontend-vue run test",
    "test:coverage": "npm --prefix frontend-vue run test:run -- --coverage",
    "test:unit": "npm --prefix frontend-vue run test:run",
    "test:ci": "npm --prefix frontend-vue run test:run"
  }
}
