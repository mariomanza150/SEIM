# SEIM Ultra-Lean / Minimum single-host environment
# Copy to .env.lean (Ultra-Lean) or adapt for .env.prod (Minimum).
# See docs/deployment.md — AWS deployment profiles.

# --- Django ---
DJANGO_ENV=production
DEBUG=false
SECRET_KEY=change-me-to-a-long-random-string
ALLOWED_HOSTS=your-domain.com,www.your-domain.com
CORS_ALLOWED_ORIGINS=https://your-domain.com,https://www.your-domain.com
CSRF_TRUSTED_ORIGINS=https://your-domain.com,https://www.your-domain.com
FRONTEND_BASE_URL=https://your-domain.com

# Behind Cloudflare (Flexible or Full SSL): trust X-Forwarded-Proto
USE_TLS_PROXY_HEADERS=1
SECURE_SSL_REDIRECT=true
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=true
SECURE_HSTS_PRELOAD=true
CSRF_COOKIE_SECURE=true
SESSION_COOKIE_SECURE=true

# --- PostgreSQL (on-host container) ---
POSTGRES_DB=seim
POSTGRES_USER=seimuser
POSTGRES_PASSWORD=change-me-strong-db-password

# --- Redis ---
REDIS_PASSWORD=change-me-strong-redis-password

# --- Gunicorn (Ultra-Lean: 2 workers on t4g.small) ---
GUNICORN_WORKERS=2
GUNICORN_WORKER_CLASS=sync
GUNICORN_MAX_REQUESTS=500
GUNICORN_MAX_REQUESTS_JITTER=50
GUNICORN_TIMEOUT=30
GUNICORN_KEEP_ALIVE=2
GUNICORN_LOG_LEVEL=info

# --- Celery (combined worker+beat on Ultra-Lean) ---
CELERY_CONCURRENCY=2

# --- Email ---
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@domain.com
EMAIL_HOST_PASSWORD=your-email-password
DEFAULT_FROM_EMAIL=noreply@your-domain.com

# --- AWS S3 (private student documents; region us-east-1) ---
# Media is streamed via presigned URLs so EC2 RAM/bandwidth stay free.
USE_S3=true
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_STORAGE_BUCKET_NAME=your-seim-media-bucket
AWS_S3_REGION_NAME=us-east-1
AWS_DEFAULT_ACL=private

# Optional: SES (same region as compute for lowest cost)
# EMAIL_BACKEND=django_ses.SESBackend
# AWS_SES_REGION_NAME=us-east-1
# AWS_SES_ACCESS_KEY_ID=your-aws-access-key
# AWS_SES_SECRET_ACCESS_KEY=your-aws-secret-key

# --- Database backups to S3 (scripts/backup_db_s3.sh) ---
AWS_BACKUP_BUCKET=your-seim-backup-bucket
# Optional overrides for the backup script:
# COMPOSE_FILE=docker-compose.lean.yml
# POSTGRES_CONTAINER=seim-postgres-lean
# BACKUP_RETENTION_DAYS=30

# --- Virus scanner (ClamAV omitted from base AWS profiles) ---
VIRUS_SCANNER_TYPE=mock
VIRUS_SCANNER_TIMEOUT=30
VIRUS_SCAN_FAIL_SECURE=false

# --- Logging ---
LOG_LEVEL=INFO
