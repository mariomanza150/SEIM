# SEIM Production Environment Configuration
# Copy this file to .env.prod and fill in your actual values.
# Maps to the **Minimum** AWS tier (~$65/mo, t4g.medium) — see docs/deployment.md.
# For Ultra-Lean (t4g.small), use env.lean.example → .env.lean with docker-compose.lean.yml.
# Use Docker secrets for sensitive values on the Minimum/Recommended profiles.

# Django Configuration
DJANGO_ENV=production
DEBUG=false
# SECRET_KEY will be read from Docker secrets file
ALLOWED_HOSTS=your-domain.com,www.your-domain.com,api.your-domain.com
FRONTEND_BASE_URL=https://your-domain.com

# CORS Configuration (CRITICAL: Set these for production security!)
CORS_ALLOWED_ORIGINS=https://your-domain.com,https://www.your-domain.com,https://app.your-domain.com
CSRF_TRUSTED_ORIGINS=https://your-domain.com,https://www.your-domain.com,https://app.your-domain.com

# Behind Cloudflare: trust X-Forwarded-Proto / client IP headers
USE_TLS_PROXY_HEADERS=1

# Database Configuration (on-host Postgres for Minimum; use RDS URL for Recommended)
POSTGRES_DB=seim
POSTGRES_USER=seimuser
# POSTGRES_PASSWORD will be read from Docker secrets file
# Recommended (split tier): set DATABASE_URL to RDS instead of relying on the compose db service
# DATABASE_URL=postgresql://seimuser:PASSWORD@your-rds.xxxxx.us-east-1.rds.amazonaws.com:5432/seim

# Redis Configuration
# REDIS_PASSWORD will be read from Docker secrets file
# Recommended (split tier): ElastiCache endpoint
# REDIS_URL=redis://:PASSWORD@your-elasticache.xxxxx.cache.amazonaws.com:6379/0

# Gunicorn Configuration (Minimum / t4g.medium defaults)
GUNICORN_WORKERS=3
GUNICORN_WORKER_CLASS=sync
GUNICORN_WORKER_CONNECTIONS=1000
GUNICORN_MAX_REQUESTS=1000
GUNICORN_MAX_REQUESTS_JITTER=100
GUNICORN_TIMEOUT=30
GUNICORN_KEEP_ALIVE=2
GUNICORN_LOG_LEVEL=info

# Celery Configuration (separated worker + beat containers on Minimum)
CELERY_CONCURRENCY=2
CELERY_REPLICAS=1

# Scaling Configuration (single host Minimum)
WEB_REPLICAS=1

# Email Configuration
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
# EMAIL_HOST_USER will be read from Docker secrets file
# EMAIL_HOST_PASSWORD will be read from Docker secrets file
DEFAULT_FROM_EMAIL=noreply@your-domain.com

# AWS S3 — private student documents (us-east-1; Cloudflare caches HTML/static at edge)
USE_S3=true
AWS_STORAGE_BUCKET_NAME=your-s3-media-bucket
AWS_S3_REGION_NAME=us-east-1
AWS_DEFAULT_ACL=private
# AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY from Docker secrets (Minimum)
# Or IAM instance role on EC2 (preferred)

# Daily DB backups (scripts/backup_db_s3.sh) — Ultra-Lean / Minimum
AWS_BACKUP_BUCKET=your-seim-backup-bucket
# COMPOSE_FILE=docker-compose.prod.yml
# POSTGRES_CONTAINER=seim-db-prod
# BACKUP_RETENTION_DAYS=30

# Virus Scanner — ClamAV omitted from base AWS profiles (saves 1.2–1.5 GB RAM).
# Optional: docker compose -f docker-compose.prod.yml --profile clamav up -d
# then set VIRUS_SCANNER_TYPE=clamav and VIRUS_SCANNER_HOST=clamav
VIRUS_SCANNER_TYPE=mock
VIRUS_SCANNER_TIMEOUT=30
VIRUS_SCAN_FAIL_SECURE=false

# Logging Configuration
LOG_LEVEL=INFO

# Security Configuration
SECURE_SSL_REDIRECT=true
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=true
SECURE_HSTS_PRELOAD=true
CSRF_COOKIE_SECURE=true
SESSION_COOKIE_SECURE=true

# Performance Configuration
CACHE_TIMEOUT=300
SESSION_COOKIE_AGE=3600

# Monitoring Configuration (optional)
ENABLE_MONITORING=false
MONITORING_ENDPOINT=http://monitoring:9090
